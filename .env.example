# MongoDB Atlas
MONGODB_URI=
MONGO_DB_NAME=french_learning

# Azure Speech (Text-to-Speech REST API)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=french-lessons

# Optional: lifetime of read-only SAS links written to run reports (hours)
AUDIO_SAS_HOURS=168
