# Server-only MongoDB access
MONGODB_URI=
MONGO_DB_NAME=french_learning

# Server-only Azure Blob signing (required only when audio is private)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=french-lessons
# SAS lifetime is capped by the app to 5–60 minutes.
AUDIO_SAS_MINUTES=30

# Upstash Redis REST cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
